{
  "name": "dev-quick-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "All-in-one developer toolbox extension for Chrome/Edge (Manifest V3). 100% local, zero network.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "icons": "node scripts/generate-icons.mjs",
